{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept.schema.json",
  "title": "개념 카드",
  "description": "배포 단위. 설계서 §2.1. 규칙 상수는 §4.4.",
  "type": "object",
  "required": [
    "id", "concept_key", "term", "notation", "definition", "definition_source",
    "relations", "misconceptions", "links", "curriculum", "subject", "unit",
    "difficulty", "version"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^(isci1|isci2|chem|mate|reac)-[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "concept_key": { "type": "string", "pattern": "^concept:[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "registry_status": { "type": "string", "enum": ["reused", "new"] },

    "term": { "type": "string", "minLength": 1, "maxLength": 30 },
    "aliases": {
      "description": "검색 허용 표기. 표제어가 아니다. 구표기는 여기 들어간다 (R6).",
      "type": "array", "items": { "type": "string" }
    },

    "notation": {
      "type": "object",
      "required": ["hanja", "english"],
      "additionalProperties": false,
      "properties": {
        "hanja": {
          "description": "세 상태를 구분한다 — 한자어 / \"해당 없음\"(음차어) / null(미조사). null 은 배포 전에 없어져야 한다 (R7).",
          "type": ["string", "null"]
        },
        "hanja_note": { "type": "string" },
        "hanja_gloss": {
          "description": "글자 수 = 훈음 항목 수. 형식: 蒸 찔 증 · 氣 기운 기",
          "type": "string"
        },
        "english": { "type": "string", "minLength": 1 },
        "symbol_display": { "type": "string" },
        "symbol_plain": {
          "description": "입력·검색·정답 대조용 평문 (R8). typeability-check 가 만든다.",
          "type": "string"
        }
      }
    },

    "definition": { "type": "string", "minLength": 20, "maxLength": 160 },
    "definition_source": {
      "description": "restated = 원문을 구조적으로 다시 썼다 (R4). 그 외 값은 C4 에서 걸린다.",
      "type": "string", "enum": ["restated"]
    },

    "relations": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "text", "form", "invertible", "invertible_reason", "curriculum", "verified_by"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^rel-[a-z0-9-]+$" },
          "text": { "type": "string", "minLength": 8, "maxLength": 120 },
          "form": {
            "type": "object",
            "required": ["condition", "type", "scope"],
            "additionalProperties": false,
            "properties": {
              "condition": {
                "description": "이 명제가 성립하는 전제. 비면 C6 에서 반려된다.",
                "type": "string", "minLength": 2
              },
              "antecedent": { "$ref": "#/$defs/quantity" },
              "consequent": { "$ref": "#/$defs/quantity" },
              "type": { "type": "string", "enum": ["direct", "inverse", "conditional", "causal", "classification"] },
              "scope": {
                "description": "명제가 참인 조건 경계. 이것이 빠지면 명제가 오개념이 된다.",
                "type": "string", "minLength": 2
              }
            }
          },
          "invertible": {
            "description": "방향을 뒤집으면 반드시 거짓이 되는가. OX 오답 자동 생성의 가부.",
            "type": "boolean"
          },
          "invertible_reason": { "type": "string", "minLength": 5 },
          "inverted_text": {
            "description": "invertible 이 true 일 때 뒤집은 문장 — D1 의 OX 오답 원천",
            "type": "string"
          },
          "curriculum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "verified_by": {
            "description": "teacher 만 데일리 문항에 쓸 수 있다 (CLAUDE.md §9.1). C8 게이트 전에는 pending.",
            "type": "string", "enum": ["pending", "teacher"]
          }
        }
      }
    },

    "misconceptions": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["text", "why_wrong", "source"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 8 },
          "why_wrong": { "type": "string", "minLength": 10 },
          "linked_relation": { "type": "string" },
          "source": { "type": "string", "enum": ["teacher", "llm", "log"] }
        }
      }
    },

    "links": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["prereq", "next", "same", "related"] },
          "target": { "type": "string" },
          "note": { "type": "string" },
          "grade_from": { "type": "string" }
        }
      }
    },

    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "caption", "access_tier"],
        "additionalProperties": false,
        "properties": {
          "asset_id": { "type": "string" },
          "file": { "type": "string" },
          "kind": { "type": "string" },
          "caption": { "type": "string" },
          "access_tier": { "type": "string", "enum": ["public", "restricted"] },
          "source": { "type": "string" }
        }
      }
    },

    "curriculum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "subject": { "type": "string" },
    "unit": { "type": "string" },
    "unit_id": { "type": "string" },
    "topic_id": { "type": "string" },
    "pages": { "type": "array", "items": { "type": "integer" } },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "role": { "type": "string", "enum": ["core", "supporting", "context"] },
    "version": { "type": "integer", "minimum": 1 },
    "quiz_ready": {
      "description": "C8 부분 승인의 결과. false 면 데일리 문항에서 제외한다.",
      "type": "boolean"
    }
  },

  "$defs": {
    "quantity": {
      "type": "object",
      "required": ["quantity", "direction"],
      "additionalProperties": false,
      "properties": {
        "quantity": { "type": "string" },
        "direction": { "type": "string", "enum": ["증가", "감소", "일정", "해당 없음"] }
      }
    }
  }
}
